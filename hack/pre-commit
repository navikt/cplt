#!/bin/sh
set -e

# Run on rustup's toolchain pinned in rust-toolchain.toml (the one CI uses).
# A Rust earlier on PATH (Homebrew's, say) ignores the pin, and newer clippy
# releases add lints the tree does not pass yet, so never fall back to it.
rustup=$(command -v rustup || echo "${CARGO_HOME:-$HOME/.cargo}/bin/rustup")
if [ ! -x "$rustup" ]; then
    echo "pre-commit: rustup not found. Install it (https://rustup.rs) so the checks run on the pinned toolchain." >&2
    exit 1
fi
pin=$(sed -n 's/^channel = "\(.*\)"$/\1/p' "$(git rev-parse --show-toplevel)/rust-toolchain.toml")
cargo() { "$rustup" run "$pin" cargo "$@"; }

echo "Using $("$rustup" run "$pin" rustc --version)"

echo "Running cargo fmt --check..."
cargo fmt -- --check || {
    echo "Format check failed. Run 'cargo fmt' to fix."
    exit 1
}

echo "Running cargo clippy..."
cargo clippy --all-targets -- -D warnings || {
    echo "Clippy check failed. Fix the warnings above."
    exit 1
}
